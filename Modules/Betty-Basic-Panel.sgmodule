[Panel]
贝蒂的基础面板 = script-name=Betty-Basic-Panel, update-interval=1800

[Script]
Betty-Basic-Panel = type=generic, script-path=https://raw.githubusercontent.com/BeatriceArchive/Beatrice-Surge-Modules/main/Scripts/Betty-Basic-Panel.js, timeout=90, argument="YS=1&RISK=1"
