#!name=贝蒂的哔哩哔哩 Cookie 获取
#!desc=通过 Surge Panel 手动创建 Bilibili 官方二维码登录事务；二维码仅在本机生成并显示，不再打开浏览器。扫码成功后补全主站会话并将 Cookie 保存到 Surge 本地。无需 MITM、CA 或 HTTPS 解密。
#!author=BeatriceArchive
#!category=Beatrice
# Version: 1.3.1
# Project: Betty-Bilibili-Daily

[Panel]
贝蒂的哔哩哔哩 Cookie 获取 = title="贝蒂的哔哩哔哩 Cookie 获取",content="点击刷新生成官方登录二维码｜不会打开浏览器",icon=key.fill,icon-color="#8E8E93",script-name=Betty-Bilibili-Cookie,update-interval=1

[Script]
Betty-Bilibili-Cookie = type=generic,script-path=https://raw.githubusercontent.com/BeatriceArchive/Beatrice-Surge-Modules/main/Scripts/Betty-Bilibili-Cookie.js,timeout=180,script-update-interval=60
